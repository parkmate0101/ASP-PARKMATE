@model ParkMate.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "ParkMate Login";
}

<link rel="stylesheet" href="~/css/login1.css" asp-append-version="true" />

<div class="parkmate-auth-container">

    <div class="auth-left">
        <img src="~/images/loginimage.png"
             alt="ParkMate Parking" />
    </div>

    <div class="auth-right">

        <div class="parkmate-logo">
            Park<span>Mate</span>
        </div>

        <h1 class="auth-title">
            LOGIN
        </h1>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="success-message">
                @TempData["SuccessMessage"]
            </div>
        }

        <p class="auth-helper-text">
            Enter your password, or leave it blank to login using OTP.
        </p>

        <form asp-controller="Auth"
              asp-action="Login"
              method="post"
              onsubmit="return validateLogin();">

            @Html.AntiForgeryToken()

            <input asp-for="ReturnUrl" type="hidden" />

            <input asp-for="Email"
                   class="auth-input"
                   placeholder="EMAIL"
                   autocomplete="email" />

            <span asp-validation-for="Email" class="auth-error"></span>

            <input asp-for="Password"
                   class="auth-input"
                   placeholder="PASSWORD (OPTIONAL FOR OTP LOGIN)"
                   autocomplete="current-password" />

            <span asp-validation-for="Password" class="auth-error"></span>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="server-error">
                    @foreach (var error in ViewData.ModelState.Values
                        .SelectMany(v => v.Errors))
                    {
                        if (!string.IsNullOrWhiteSpace(error.ErrorMessage))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    }
                </div>
            }

            <div class="forgot-row">
                <a asp-controller="Auth"
                   asp-action="ForgotPassword"
                   class="forgot-link">
                    Forgot Password?
                </a>
            </div>

            <button type="submit"
                    class="auth-button">
                LOGIN
            </button>

        </form>

        <div class="auth-question">
            Not registered yet?
        </div>

        <a asp-controller="Auth"
           asp-action="Register"
           asp-route-returnUrl="@Model.ReturnUrl"
           class="auth-button auth-link-button">
            SIGN-UP
        </a>

    </div>

</div>

<script src="~/js/login.js" asp-append-version="true"></script>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
