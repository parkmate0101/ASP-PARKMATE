@model ParkMate.ViewModels.SetPasswordViewModel

@{
    ViewData["Title"] = "Set Password";
}

<link rel="stylesheet" href="~/css/set_password.css" asp-append-version="true" />
<script src="~/js/set_password.js" asp-append-version="true"></script>

<div class="parkmate-auth-container password-page">

    <div class="auth-left">
        <img src="~/images/loginimage.png"
             alt="ParkMate Parking" />
    </div>

    <div class="auth-right">

        <div class="parkmate-logo">
            Park<span>Mate</span>
        </div>

        <h1 class="auth-title">
            SET PASSWORD
        </h1>

        <p class="password-helper">
            Create a password for your ParkMate account.
        </p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="server-error password-server-error">
                @foreach (var error in ViewData.ModelState.Values
                    .SelectMany(v => v.Errors))
                {
                    if (!string.IsNullOrWhiteSpace(error.ErrorMessage))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                }
            </div>
        }

        <form asp-controller="Auth"
              asp-action="SetPassword"
              method="post"
              onsubmit="return validatePassword();">

            @Html.AntiForgeryToken()

            <input asp-for="Password"
                   class="password-input"
                   type="password"
                   placeholder="NEW PASSWORD"
                   autocomplete="new-password" />

            <span asp-validation-for="Password"
                  class="password-error"></span>

            <input asp-for="ConfirmPassword"
                   class="password-input"
                   type="password"
                   placeholder="CONFIRM PASSWORD"
                   autocomplete="new-password" />

            <span asp-validation-for="ConfirmPassword"
                  class="password-error"></span>

            <button type="submit"
                    class="password-button">
                SAVE PASSWORD
            </button>

        </form>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
