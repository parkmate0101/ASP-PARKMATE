@model ParkMate.ViewModels.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<link rel="stylesheet" href="~/css/otp.css" asp-append-version="true" />

<div class="otp-page">
    <div class="otp-card">

        <div class="otp-logo">🚗 ParkMate</div>

        <h1>Forgot Password</h1>

        <p>
            Enter your registered email address and we will send a password reset OTP.
        </p>

        <form asp-controller="Auth"
              asp-action="ForgotPassword"
              method="post">

            @Html.AntiForgeryToken()

            <input asp-for="Email"
                   class="otp-input"
                   type="email"
                   placeholder="Enter registered email"
                   autocomplete="email" />

            <span asp-validation-for="Email"
                  class="otp-error"></span>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="otp-error-box">
                    @foreach (var error in ViewData.ModelState.Values
                        .SelectMany(v => v.Errors))
                    {
                        if (!string.IsNullOrWhiteSpace(error.ErrorMessage))
                        {
                            <div>@error.ErrorMessage</div>
                        }
                    }
                </div>
            }

            <button type="submit" class="otp-button">
                SEND RESET OTP
            </button>
        </form>

        <a asp-controller="Auth"
           asp-action="Login"
           class="otp-back-link">
            ← Back to Login
        </a>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
