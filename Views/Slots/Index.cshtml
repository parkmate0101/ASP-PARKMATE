@model IEnumerable<ParkMate.Models.Slot>

@{
    Layout = "~/Views/Shared/_AdminDashboardLayout.cshtml";
    ViewData["Title"] = "Parking Slots";

    var slotList = Model.ToList();
    var slotIds = slotList.Select(s => s.SlotId).Distinct().OrderBy(id => id).ToList();
    var totalSlots = slotList.Count;
    var availableSlots = slotList.Count(s => s.SlotStatus == "Available");
    var blockedSlots = slotList.Count(s => s.SlotStatus == "Blocked");
}

<div class="admin-page">
    <div class="admin-container">

        <div class="admin-header">
            <div class="admin-heading">
                <h1>Parking Slots</h1>
                <p>Manage parking spaces, vehicle types and slot availability.</p>
            </div>

            <a asp-action="Create" class="pm-btn pm-btn-primary">
                + Add Parking Slot
            </a>
        </div>

        <div class="pm-mini-grid">
            <div class="pm-mini-card"><span>Total Slots</span><strong>@totalSlots</strong></div>
            <div class="pm-mini-card"><span>Available</span><strong>@availableSlots</strong></div>
            <div class="pm-mini-card"><span>Blocked</span><strong>@blockedSlots</strong></div>
        </div>

        <div class="pm-card">
            <div class="pm-card-header"><h2>All Parking Slots</h2></div>
            <div class="pm-card-body">
                <div class="pm-table-wrapper">
                    <table class="pm-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Slot Number</th>
                                <th>Vehicle Type</th>
                                <th>Status</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!slotList.Any())
                            {
                                <tr>
                                    <td colspan="5" class="pm-empty">
                                        <div class="pm-empty-icon">🅿️</div>
                                        <h3>No parking slots found</h3>
                                        <p>Add your first parking slot to get started.</p>
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var slot in slotList)
                                {
                                    int slotDisplayId = slotIds.IndexOf(slot.SlotId) + 1;
                                    <tr>
                                        <td>#S @slotDisplayId</td>
                                        <td><span class="pm-slot-number">@slot.SlotNum</span></td>
                                        <td>@(slot.SlotType == "2_wheeler" ? "2 Wheeler" : "4 Wheeler")</td>
                                        <td>
                                            @if (slot.SlotStatus == "Available")
                                            {
                                                <span class="pm-badge pm-badge-available">Available</span>
                                            }
                                            else
                                            {
                                                <span class="pm-badge pm-badge-blocked">Blocked</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="pm-actions">
                                                <a asp-action="Edit" asp-route-id="@slot.SlotId" class="pm-btn pm-btn-warning">Edit</a>
                                                <a asp-action="Delete" asp-route-id="@slot.SlotId" class="pm-btn pm-btn-danger">Delete</a>
                                                <form asp-action="ToggleStatus" asp-route-id="@slot.SlotId" method="post">
                                                    @Html.AntiForgeryToken()
                                                    @if (slot.SlotStatus == "Available")
                                                    {
                                                        <button type="submit" class="pm-btn pm-btn-secondary">Block</button>
                                                    }
                                                    else
                                                    {
                                                        <button type="submit" class="pm-btn pm-btn-success">Make Available</button>
                                                    }
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="pm-card" style="margin-top:24px;">
            <div class="pm-card-header" style="display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap;">
                <h2>REST API Integration</h2>
                <button type="button" id="loadSlotsFromApi" class="pm-btn pm-btn-primary">
                    Load Slots from API
                </button>
            </div>
            <div class="pm-card-body">
                <p id="apiStatus" style="margin-bottom:15px;color:#64748b;">
                    Click the button to load the latest parking-slot data from <strong>/api/slots</strong>.
                </p>
                <div class="pm-table-wrapper">
                    <table class="pm-table" id="apiSlotsTable">
                        <thead>
                            <tr>
                                <th>API Slot ID</th>
                                <th>Slot Number</th>
                                <th>Vehicle Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="apiSlotsBody">
                            <tr>
                                <td colspan="4" class="pm-empty">API data has not been loaded yet.</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script src="~/js/api-integration.js" asp-append-version="true"></script>
}
